# ─────────────────────────────────────────────────────────────
# Glovek 운영 어드민 — 환경변수 (00-MASTER-PLAN 4-4 규약)
# 값은 절대 커밋하지 말 것. Vercel/서버 시크릿으로만 주입.
# ─────────────────────────────────────────────────────────────

# 공유 Postgres (쓰기: 어드민 CRM 테이블 / 읽기: glovek 테이블)
DATABASE_URL=postgres://user:pass@host:5432/glovek

# (옵션) glovek 읽기전용 롤을 분리한 경우. 미설정 시 DATABASE_URL 사용.
GLOVEK_DB_URL_RO=

# (옵션) glovek.space 양방향 동기화 — 셋 다 미설정이면 push/webhook 비활성(dormant).
#   admin→glovek push 대상(glovek brand-upsert 엔드포인트)
GLOVEK_PUSH_URL=https://glovek.space/api/partner/brand-upsert
#   위 호출 Bearer 토큰 = glovek 이 발급한 PARTNER_ADMIN_TOKEN 값
GLOVEK_PUSH_TOKEN=
#   glovek→admin 웹훅(/api/partner/glovek-webhook) HMAC 검증 = glovek 의 PARTNER_WEBHOOK_SECRET 값(양측 동일)
GLOVEK_WEBHOOK_SECRET=

# 사이트 → 어드민 ingest 인증 (X-Ingest-Secret 헤더 검증값)
INGEST_SECRET=change-me-ingest-secret

# 어드민 세션 서명 키 (쿠키 HMAC)
ADMIN_SESSION_SECRET=change-me-session-secret

# 내부 접근 화이트리스트 (콤마 구분 이메일)
ADMIN_ALLOWED_EMAILS=jaybe@dinostudio.kr

# cron 라우트 보호용 시크릿 (Vercel Cron Authorization: Bearer)
CRON_SECRET=change-me-cron-secret

# Slack App (05-SLACK-APP)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_CH_INTAKE=C0INTAKE
SLACK_CH_ONBOARD=C0B753MKLV9
SLACK_CH_ADS=C0ADS
SLACK_CH_PAY=C0PAY
SLACK_CH_LEADS=C0LEADS
SLACK_CH_DAILY=C0DAILY

# Claude (에이전트/브리프 생성, /ask)
ANTHROPIC_API_KEY=sk-ant-...

# 브랜드 리마인더 메일 (Resend)
RESEND_API_KEY=
RESEND_FROM=Glovek <onboarding@glovek.space>

# MCP 서버 인증 토큰
MCP_TOKEN=change-me-mcp-token

# 어드민 공개 URL (Slack 딥링크 등에 사용)
ADMIN_URL=http://localhost:3000
